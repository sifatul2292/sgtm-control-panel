PORT=3000
HOST=127.0.0.1

# Required on public deployments. Set AUTH_ENABLED=false only for local development.
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password
# Optional but recommended: set a long random value to keep sessions valid across restarts.
AUTH_SECRET=change-this-long-random-secret

# Recommended: use dedicated SGTM-only logs instead of global Nginx logs.
# Configure Nginx to write these files for the SGTM server block.
# SGTM_ACCESS_LOG=/var/log/nginx/sgtm-access.log
# SGTM_ERROR_LOG=/var/log/nginx/sgtm-error.log

# Fallback: override where global Nginx logs live on your VPS.
NGINX_ACCESS_LOG=/var/log/nginx/access.log
NGINX_ERROR_LOG=/var/log/nginx/error.log

# Optional: set either a local certificate path or a public domain for SSL expiry.
# SSL_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
SSL_DOMAIN=example.com
SSL_PORT=443

# Optional: the number of log lines returned to the dashboard.
LOG_TAIL_LINES=80

# Optional: latest matching SGTM events shown in the Event Logs table.
EVENT_LOG_LIMIT=500

# Optional: only these request paths count as SGTM event traffic.
# Loader/script paths like /gtm.js can be noisy, so they are not counted by default.
TRACKING_PATHS=/g/collect,/collect,/mp/collect,/data

# Optional: hide shared Nginx errors from unrelated domains.
# If empty, the app tries to infer this from SSL_CERT_PATH or SSL_DOMAIN.
TRACKING_HOSTS=sgtm.shobaz.com,server.shobaz.com,shobaz.com

# Optional: hide noisy SGTM container diagnostic lines.
DOCKER_LOG_EXCLUDE=Sending aggregate usage beacon,googletagmanager.com/sgtm/a

# Optional: POST JSON alerts to a webhook. Leave blank to disable.
# ALERT_WEBHOOK_URL=https://example.com/webhook
ALERT_MIN_INTERVAL_MINUTES=60

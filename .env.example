PORT=3000
HOST=127.0.0.1

# Required on public deployments. Set AUTH_ENABLED=false only for local development.
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password
# Optional but recommended: set a long random value to keep sessions valid across restarts.
AUTH_SECRET=change-this-long-random-secret

# Service/customer metadata used by the admin, billing, and docs screens.
SERVICE_NAME=Tagioo
PUBLIC_BASE_URL=https://tagioo.com
TENANT_ID=default
TENANT_NAME=Default Customer
TENANT_DOMAIN=server.example.com
CUSTOMER_SUPPORT_EMAIL=support@tagioo.com

# Transactional email. Resend is the sender; Brevo is only used when
# RESEND_API_KEY is empty. With neither set, no mail is sent and signup
# verification codes are printed to the console instead (local dev only).
# The From address is CUSTOMER_SUPPORT_EMAIL and must be on a domain verified
# with whichever provider is active, or the send is rejected.
RESEND_API_KEY=
# BREVO_API_KEY=

# Request-based billing guardrails.
BILLING_PLAN=Starter
MONTHLY_REQUEST_LIMIT=100000
MONTHLY_CONTAINER_LIMIT=1

# Recommended: use dedicated SGTM-only logs instead of global Nginx logs.
# Configure Nginx to write these files for the SGTM server block.
# SGTM_ACCESS_LOG=/var/log/nginx/sgtm-access.log
# SGTM_ERROR_LOG=/var/log/nginx/sgtm-error.log

# Fallback: override where global Nginx logs live on your VPS.
NGINX_ACCESS_LOG=/var/log/nginx/access.log
NGINX_ERROR_LOG=/var/log/nginx/error.log

# Optional: set either a local certificate path or a public domain for SSL expiry.
# SSL_CERT_PATH=/etc/letsencrypt/live/tagioo.com/fullchain.pem
SSL_DOMAIN=tagioo.com
SSL_PORT=443

# Optional: the number of log lines returned to the dashboard.
LOG_TAIL_LINES=80

# Optional: the number of recent access-log lines scanned for the dashboard summary.
# Keep this bounded so large VPS logs do not make the dashboard slow.
SUMMARY_TAIL_LINES=50000

# Optional: latest matching SGTM events shown in the Event Logs table.
EVENT_LOG_LIMIT=500

# Optional: local summary database location and retention.
DATA_DIR=./data
HISTORY_RETENTION_DAYS=90

# Optional: auto-assigned internal port range for new SGTM instances.
PROVISION_PORT_START=8200
PROVISION_PORT_END=8999
# DNS target shown to customers. Customers point CNAME records to this host.
PROVISION_DNS_TARGET=bd.tagioo.com
# Optional: where Docker/Nginx draft files are written before launch.
PROVISION_OUTPUT_DIR=./data/provisioning

# Automatic customer container launch.
AUTO_LAUNCH_ENABLED=true
AUTO_LAUNCH_REQUIRE_DNS=true
AUTO_LAUNCH_CERTBOT=true
AUTO_LAUNCH_CERTBOT_EMAIL=admin@tagioo.com
AUTO_LAUNCH_USE_SUDO=true
NGINX_SITES_AVAILABLE_DIR=/etc/nginx/sites-available
NGINX_SITES_ENABLED_DIR=/etc/nginx/sites-enabled
# Only set this if you already define the named log_format in Nginx.
# NGINX_LOG_FORMAT=sgtm_panel

# Local worker capacity. This represents the current VPS.
LOCAL_WORKER_ID=tagioo-bdix-1
LOCAL_WORKER_NAME="Tagioo BDIX Worker 1"
LOCAL_WORKER_REGION="Bangladesh BDIX"
LOCAL_WORKER_PUBLIC_HOST=bd.tagioo.com
LOCAL_WORKER_IP=147.79.67.213
LOCAL_WORKER_MAX_CONTAINERS=200
LOCAL_WORKER_CPU_CORES=1
LOCAL_WORKER_MEMORY_GB=4
LOCAL_WORKER_DISK_GB=50
DEFAULT_CONTAINER_MEMORY_MB=512
DEFAULT_CONTAINER_CPU_LIMIT=0.50

# Optional: only these request paths count as SGTM event traffic.
# Loader/script paths like /gtm.js can be noisy, so they are not counted by default.
TRACKING_PATHS=/g/collect,/collect,/mp/collect,/data

# Optional: hide shared Nginx errors from unrelated domains.
# If empty, the app tries to infer this from SSL_CERT_PATH or SSL_DOMAIN.
TRACKING_HOSTS=tagioo.com,app.tagioo.com,bd.tagioo.com

# Optional: hide noisy SGTM container diagnostic lines.
DOCKER_LOG_EXCLUDE=Sending aggregate usage beacon,googletagmanager.com/sgtm/a

# Optional: POST JSON alerts to a webhook. Leave blank to disable.
# ALERT_WEBHOOK_URL=https://example.com/webhook
ALERT_MIN_INTERVAL_MINUTES=60

# Optional: receive real store orders so Business Snapshot does not have to guess
# from SGTM access logs. Send POST /api/orders/webhook with this secret.
# ORDER_WEBHOOK_SECRET=change-this-order-webhook-secret

# Paddle: card checkout for US/international customers, parallel to the
# bKash/Nagad manual claim flow. Leave PADDLE_CLIENT_TOKEN blank to keep the
# checkout page bKash/Nagad-only. Webhook destination: POST /api/paddle/webhook
# (Paddle dashboard > Developer Tools > Notifications), subscribed to
# transaction.completed, subscription.canceled, subscription.paused.
# PADDLE_CLIENT_TOKEN and the three price IDs are safe to expose (client-side).
# PADDLE_API_KEY and PADDLE_WEBHOOK_SECRET are real secrets — never commit them.
# PADDLE_ENV=sandbox
# PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxx
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_ID_STARTER=
# PADDLE_PRICE_ID_GROWTH=
# PADDLE_PRICE_ID_PRO=

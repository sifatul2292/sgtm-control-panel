{
  "name": "tagioo/laravel",
  "description": "Failure-isolated Laravel purchase bridge for Tagioo server-side tracking",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "illuminate/database": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/queue": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Tagioo\\Laravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tagioo\\Laravel\\TagiooServiceProvider"
      ],
      "aliases": {
        "Tagioo": "Tagioo\\Laravel\\Facades\\Tagioo"
      }
    }
  }
}
